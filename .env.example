# Niemals echte Secrets committen. Production lädt diese Datei über systemd.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=CHANGE_ME_TO_AT_LEAST_50_RANDOM_CHARACTERS
TOTP_ENCRYPTION_KEY=CHANGE_ME_TO_AN_INDEPENDENT_RANDOM_SECRET
BACKUP_ENCRYPTION_KEY=CHANGE_ME_TO_AN_INDEPENDENT_RANDOM_SECRET
BACKUP_RETENTION_COUNT=10
PENDING_EMAIL_RETENTION_DAYS=30
RECOVERY_CODE_RETENTION_DAYS=90
IMPORT_BATCH_RETENTION_DAYS=30
AUDIT_SECURITY_RETENTION_DAYS=365
AUDIT_ACTIVITY_RETENTION_DAYS=180
NOTIFICATION_RETENTION_DAYS=90
SOFT_DELETE_RETENTION_DAYS=30
PRIVATE_DOCUMENT_DELETED_RETENTION_DAYS=30
# 0 = bewusst unbegrenzt wegen Import-Idempotenz und Migrationsnachweis.
LEGACY_DATA_RETENTION_DAYS=0
DJANGO_ALLOWED_HOSTS=brickmissing.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://brickmissing.example.com
DJANGO_PUBLIC_URL=https://brickmissing.example.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=brickmissing
DB_USER=brickmissing
DB_PASSWORD=CHANGE_ME
DB_CONN_MAX_AGE=60
# Optional read-only V7 MariaDB source used only by migration commands.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.testmail.app
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=BrickMissing <noreply@example.com>
SERVER_EMAIL=server@example.com
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_TIMEOUT=86400
BRICKECONOMY_API_KEY=
BRICKSET_API_KEY=
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=
IMAGE_PROXY_ALLOWED_HOSTS=rebrickable.com,brickset.com,lego.com
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
LOG_LEVEL=INFO
# Rechtliche Betreiberbasisdaten – vor öffentlicher Veröffentlichung ausfüllen.
LEGAL_OPERATOR_NAME=Vor- und Nachname oder tatsächlicher Betreibername
LEGAL_OPERATOR_ADDRESS=Straße Hausnummer, PLZ Ort
LEGAL_OPERATOR_EMAIL=kontakt@example.com
LEGAL_OPERATOR_COUNTRY=Österreich
# Optional / nur falls tatsächlich anwendbar.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_REGISTER_NUMBER=
LEGAL_COMPANY_REGISTER_COURT=
LEGAL_VAT_ID=
LEGAL_AUTHORITY=
LEGAL_CHAMBER=
LEGAL_PROFESSION=
LEGAL_MEDIA_OWNER=
